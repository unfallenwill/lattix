{
  "name": "@lattix/tui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "lattix": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/cli.js",
    "dev": "tsx ./src/cli.tsx"
  },
  "dependencies": {
    "@inkjs/ui": "^2.0.0",
    "@lattix/client": "0.1.0",
    "@lattix/protocol": "0.1.0",
    "@lattix/shared": "0.1.0",
    "ink": "^5.0.0",
    "react": "^18.3.1",
    "string-width": "^8.2.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@lattix/core": "0.1.0",
    "@types/react": "^18.3.31",
    "@types/ws": "^8.5.13",
    "ink-testing-library": "^4.0.0"
  }
}
